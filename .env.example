RESEND_API_KEY=
CONTACT_ADMIN_EMAIL=
SUPPORT_CONTACT_ADMIN_EMAIL=
CONTACT_FROM_EMAIL=
CONTACT_REPLY_TO_EMAIL=
# Support の送信元と Reply-To。未設定なら CONTACT_* と共通のアドレスを使う。
# 送信元は Resend で認証済みドメインのアドレスにする。
SUPPORT_CONTACT_FROM_EMAIL=
SUPPORT_CONTACT_REPLY_TO_EMAIL=
CONTACT_CORS_ORIGINS=https://candpluss.camp

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Shared Contact / Support API rate limits
# Upstash Console uses UPSTASH_*; Vercel Marketplace injects KV_REST_API_*.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Use a random value of at least 32 characters.
CONTACT_RATE_LIMIT_HASH_SECRET=

# Products are served from Shopify only. Required for build and runtime.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
NEXT_PUBLIC_SHOPIFY_STOREFRONT_PUBLIC_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2026-07
SHOPIFY_WEBHOOK_SECRET=

# Customer Account API (required after Vercel migration)
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=
# Customer Account API の識別子。例: https://shopify.com/authentication/1234567890
# 店舗ドメイン（https://candpluss.camp）は入れない。会員プロフィール案内が 404 になる。
SHOPIFY_CUSTOMER_ACCOUNT_URL=
# 本番のコールバック。localhost や ngrok など本番以外のホストでは
# 同じオリジンの /account/authorize に差し替える。
# Shopify の Customer Account API には、使うホストごとにその URL も登録する。
SHOPIFY_CUSTOMER_ACCOUNT_CALLBACK_URL=
SESSION_SECRET=

# Google Analytics 4 の測定 ID（G-XXXXXXXXXX）。
# 未設定の環境では計測しない。ローカルやプレビューのアクセスを混ぜないため、
# Vercel では Production だけに設定する。
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Shopify 購入テスト用の /shopify-test に掛ける Basic 認証。
# 本番で未設定のときは /shopify-test を 404 にする（誰でも見える状態を作らない）。
# ローカル開発では未設定でも通る。
TEST_AREA_BASIC_USER=
TEST_AREA_BASIC_PASSWORD=
